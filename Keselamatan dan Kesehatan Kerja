  const [expanded, setExpanded]   = useState(null);
  const [editItem, setEditItem]   = useState(null);
  const [form, setForm]           = useState({});
  const [editor, setEditor]       = useState("");
  const [toast, setToast]         = useState(null);
  const [meta, setMeta]           = useState({ ts: null, by: null });

  useEffect(() => { load(); }, []);
  useEffect(() => { const t = setInterval(load, 30000); return () => clearInterval(t); }, []);

  async function load() {
    try {
      const r = await window.storage.get(STORAGE_KEY, true);
      if (r?.value) {
        const p = JSON.parse(r.value);
        setItems(p.items); setMeta({ ts: p.ts, by: p.by });
      } else { setItems(BASE); }
    } catch { setItems(prev => prev || BASE); }
    finally { setLoading(false); }
  }

  async function persist(newItems) {
    const ts = new Date().toLocaleString("id-ID", { timeZone:"Asia/Jakarta", day:"2-digit", month:"2-digit", year:"numeric", hour:"2-digit", minute:"2-digit" });
    await window.storage.set(STORAGE_KEY, JSON.stringify({ items: newItems, ts, by: editor || "Anonim" }), true);
    setItems(newItems); setMeta({ ts, by: editor || "Anonim" });
  }

  const filtered = useMemo(() => {
    if (!items) return [];
    return items.filter(i => {
      if (i.lab !== tab) return false;
      if (search) { const q = search.toLowerCase(); if (!i.nama.toLowerCase().includes(q) && !i.kegunaan.toLowerCase().includes(q) && !i.catatan.toLowerCase().includes(q)) return false; }
      if (kFilter !== "Semua" && i.kondisi !== kFilter) return false;
      return true;
    });
  }, [items, tab, search, kFilter]);

  const stats = useMemo(() => {
    if (!items) return {};
    const s = {};
    LABS.forEach(({ id }) => {
      const arr = items.filter(i => i.lab === id);
      s[id] = { total: arr.length, good: arr.filter(i => ["Berfungsi Baik","Baik"].includes(i.kondisi)).length, attn: arr.filter(i => ["Rusak Ringan","Rusak Berat","Diajukan Kalibrasi"].includes(i.kondisi)).length, unavail: arr.filter(i => i.kondisi === "Tidak Tersedia").length };
    });
    return s;
  }, [items]);

  function openEdit(item) {
    setEditItem(item);
    setForm({ jumlah: item.jumlah, tahun: item.tahun, kondisi: item.kondisi, catatan: item.catatan });
  }

  async function handleSave() {
    setSaving(true);
    try {
      const newItems = items.map(i => i.id === editItem.id ? { ...i, ...form } : i);
      await persist(newItems);
      setEditItem(null);
      notify("Data berhasil disimpan dan disinkronkan ke semua pengguna!", "ok");
    } catch { notify("Gagal menyimpan. Silakan coba lagi.", "err"); }
    setSaving(false);
  }

  function notify(msg, type) { setToast({ msg, type }); setTimeout(() => setToast(null), 4000); }

  const st = stats[tab] || {};

  if (loading) return (
    <div style={{height:"100vh",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",background:"#F0F4F8",gap:16}}>
      <div style={{width:52,height:52,border:"4px solid #E5E7EB",borderTopColor:"#E8821C",borderRadius:"50%",animation:"spin .8s linear infinite"}}/>
      <p style={{color:"#0F2D5B",fontWeight:700,fontSize:16}}>Memuat inventaris laboratorium K3…</p>
    </div>
  );

  const rows = [];
  filtered.forEach((item, idx) => {
    const isExp = expanded === item.id;
    const cfg = KONDISI[item.kondisi] || KONDISI["Tidak Tersedia"];
    const zeroJumlah = item.jumlah === "0" || item.jumlah === 0;
    rows.push(
      <tr key={item.id} className="row" style={{borderBottom:"1px solid #F0F4F8",background:"#fff",transition:"background .1s"}}>
        <td style={{padding:"11px 14px",color:"#9CA3AF",fontWeight:600,fontSize:12}}>{idx+1}</td>
        <td style={{padding:"11px 14px"}}>
          <div style={{fontWeight:700,color:"#0F2D5B",fontSize:13}}>{item.nama}</div>
          <div style={{fontSize:11,color:"#9CA3AF",marginTop:2}}>{item.id}</div>
        </td>
        <td style={{padding:"11px 14px",maxWidth:220}}>
          <div style={{fontSize:13,color:"#374151",overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{item.kegunaan}</div>
          {item.catatan && <div style={{fontSize:11,color:"#D97706",marginTop:3,fontStyle:"italic",lineHeight:1.4}}>{item.catatan}</div>}
        </td>
        <td style={{padding:"11px 14px",textAlign:"center",fontWeight:700,fontSize:13,color:"#374151",whiteSpace:"nowrap"}}>{item.rasio}</td>
        <td style={{padding:"11px 14px",textAlign:"center"}}>
          <span style={{fontWeight:800,fontSize:14,color: zeroJumlah ? "#EF4444" : "#0F2D5B"}}>{item.jumlah}</span>
        </td>
        <td style={{padding:"11px 14px",textAlign:"center",color:"#6B7280",fontSize:13}}>{item.tahun}</td>
        <td style={{padding:"11px 14px"}}><Badge kondisi={item.kondisi}/></td>
        <td style={{padding:"11px 14px",textAlign:"center"}}>
          <div style={{display:"flex",gap:5,justifyContent:"center"}}>
            <button className="exp-btn" onClick={()=>setExpanded(isExp ? null : item.id)}
              style={{border:"1px solid #E5E7EB",borderRadius:6,padding:"4px 9px",background:"#fff",color:"#6B7280",fontSize:12,fontWeight:600}}>
              {isExp ? "▲" : "▼"}
            </button>
            <button className="edit-btn" onClick={()=>openEdit(item)}
              style={{border:"1.5px solid #E8821C",borderRadius:6,padding:"4px 10px",background:"#fff",color:"#E8821C",fontSize:12,fontWeight:700}}>
              Edit
            </button>
          </div>
        </td>
      </tr>
    );
    if (isExp) rows.push(
      <tr key={`${item.id}-d`}>
        <td colSpan={8} style={{padding:"0 14px 14px",background:"#F8FAFF",borderBottom:"1px solid #F0F4F8"}}>
          <div style={{background:"#fff",border:"1px solid #E8F0FE",borderRadius:8,padding:16,display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,animation:"fadeIn .15s ease"}}>
            <div>
              <div style={{fontSize:11,color:"#9CA3AF",fontWeight:700,textTransform:"uppercase",letterSpacing:.8,marginBottom:4}}>Kompetensi</div>
              <div style={{fontSize:13,color:"#374151"}}>{item.kompetensi}</div>
            </div>
            <div>
              <div style={{fontSize:11,color:"#9CA3AF",fontWeight:700,textTransform:"uppercase",letterSpacing:.8,marginBottom:4}}>Mata Kuliah</div>
              <div style={{fontSize:13,color:"#374151"}}>{item.mataKuliah}</div>
            </div>
            <div style={{gridColumn:"1/-1"}}>
              <div style={{fontSize:11,color:"#9CA3AF",fontWeight:700,textTransform:"uppercase",letterSpacing:.8,marginBottom:4}}>Spesifikasi Alat</div>
              <div style={{fontSize:13,color:"#374151",lineHeight:1.7}}>{item.spesifikasi}</div>
            </div>
          </div>
        </td>
      </tr>
    );
  });

  return (
    <div style={{minHeight:"100vh",background:"#F0F4F8"}}>
      <style>{css}</style>

      {/* ── HEADER ── */}
      <div style={{background:"#0F2D5B",padding:"14px 20px",display:"flex",alignItems:"center",justifyContent:"space-between",gap:12,flexWrap:"wrap"}}>
        <div style={{display:"flex",alignItems:"center",gap:14}}>
          <div style={{width:46,height:46,background:"#E8821C",borderRadius:10,display:"flex",alignItems:"center",justifyContent:"center",fontWeight:900,color:"#fff",fontSize:17,flexShrink:0,letterSpacing:-.5}}>K3</div>
          <div>
            <div style={{color:"#E8821C",fontSize:10,fontWeight:700,letterSpacing:1.2,textTransform:"uppercase"}}>Poltekkes Kemenkes Malang</div>
            <div style={{color:"#fff",fontSize:16,fontWeight:800,lineHeight:1.2}}>Inventaris Laboratorium K3</div>
            <div style={{color:"#93BFCF",fontSize:11,marginTop:1}}>Prodi Sarjana Terapan Keselamatan dan Kesehatan Kerja — Update 2026</div>
          </div>
        </div>
        <div style={{textAlign:"right",flexShrink:0}}>
          <div style={{display:"inline-flex",alignItems:"center",gap:6,background:"rgba(255,255,255,.1)",borderRadius:8,padding:"4px 10px",fontSize:11,color:"#6EE7B7",fontWeight:600,marginBottom:4}}>
            🔄 Auto-sinkron setiap 30 detik
          </div>
          {meta.ts && <div style={{color:"#93BFCF",fontSize:11}}>Diperbarui: {meta.ts}{meta.by ? ` oleh ${meta.by}` : ""}</div>}
        </div>
      </div>

      {/* ── TABS ── */}
      <div style={{background:"#0F2D5B",padding:"0 20px",display:"flex",gap:2,overflowX:"auto"}}>
        {LABS.map(({ id, icon }) => {
          const s = stats[id] || {};
          const isActive = tab === id;
          return (
            <button key={id} className={`tab-btn${isActive ? " tab-active" : ""}`} onClick={()=>setTab(id)}
              style={{padding:"10px 16px",background:"transparent",border:"none",borderBottom:"3px solid transparent",color: isActive ? "#fff" : "#93BFCF",fontSize:12,fontWeight: isActive ? 700 : 500,display:"flex",alignItems:"center",gap:7,position:"relative"}}>
              <span style={{fontSize:15}}>{icon}</span>
              <span>{id}</span>
              <span style={{background: isActive ? "#E8821C" : "rgba(255,255,255,.15)",color:"#fff",borderRadius:999,padding:"1px 7px",fontSize:10,fontWeight:700}}>{s.total||0}</span>
              {(s.attn||0) > 0 && <span style={{background:"#EF4444",color:"#fff",borderRadius:999,padding:"1px 6px",fontSize:10,fontWeight:700}}>{s.attn}</span>}
            </button>
          );
        })}
      </div>

      <div style={{padding:"16px 20px 24px"}}>
        {/* ── TOAST ── */}
        {toast && (
          <div style={{background: toast.type==="ok" ? "#065F46" : "#991B1B",color:"#fff",borderRadius:10,padding:"10px 16px",marginBottom:12,fontSize:13,fontWeight:600,animation:"fadeIn .2s ease"}}>
            {toast.type==="ok" ? "✅" : "❌"} {toast.msg}
          </div>
        )}

        {/* ── STAT BAR ── */}
        <div style={{background:"#fff",borderRadius:12,padding:"14px 20px",marginBottom:12,display:"flex",gap:24,alignItems:"center",boxShadow:"0 1px 6px rgba(0,0,0,.06)",flexWrap:"wrap"}}>
          {[
            { label:"Total Jenis Alat", val: st.total||0, color:"#0F2D5B" },
            { label:"Berfungsi / Baik", val: st.good||0, color:"#10B981" },
            { label:"Perlu Perhatian", val: st.attn||0, color:"#F59E0B" },
            { label:"Tidak Tersedia", val: st.unavail||0, color:"#9CA3AF" },
          ].map((s,i) => (
            <div key={i} style={{display:"flex",alignItems:"center",gap:12}}>
              {i > 0 && <div style={{width:1,height:32,background:"#E5E7EB"}}/>}
              <div>
                <div style={{fontSize:22,fontWeight:800,color:s.color,lineHeight:1}}>{s.val}</div>
                <div style={{fontSize:11,color:"#9CA3AF",marginTop:2,fontWeight:500}}>{s.label}</div>
              </div>
            </div>
          ))}
          <div style={{marginLeft:"auto",display:"flex",alignItems:"center",gap:6}}>
            <button onClick={load} style={{border:"1.5px solid #E5E7EB",borderRadius:8,padding:"7px 14px",background:"#fff",color:"#374151",fontSize:12,fontWeight:600,cursor:"pointer",transition:"all .15s"}}
              onMouseEnter={e=>e.currentTarget.style.background="#F3F4F6"} onMouseLeave={e=>e.currentTarget.style.background="#fff"}>
              🔄 Refresh
            </button>
          </div>
        </div>

        {/* ── SEARCH + FILTER ── */}
        <div style={{background:"#fff",borderRadius:12,padding:"12px 16px",marginBottom:12,display:"flex",gap:10,alignItems:"center",flexWrap:"wrap",boxShadow:"0 1px 6px rgba(0,0,0,.06)"}}>
          <div style={{flex:1,minWidth:200,position:"relative"}}>
            <span style={{position:"absolute",left:11,top:"50%",transform:"translateY(-50%)",fontSize:15,color:"#9CA3AF",pointerEvents:"none"}}>🔍</span>
            <input value={search} onChange={e=>setSearch(e.target.value)} placeholder="Cari nama alat, kegunaan, atau catatan…"
              style={{paddingLeft:34,width:"100%"}}/>
            {search && <button onClick={()=>setSearch("")} style={{position:"absolute",right:8,top:"50%",transform:"translateY(-50%)",background:"none",border:"none",cursor:"pointer",color:"#9CA3AF",fontSize:16,fontWeight:700,padding:2}}>×</button>}
          </div>
          <select value={kFilter} onChange={e=>setKFilter(e.target.value)} style={{width:"auto",minWidth:160}}>
            <option value="Semua">Semua Kondisi</option>
            {Object.keys(KONDISI).map(k => <option key={k} value={k}>{k}</option>)}
          </select>
          <div style={{fontSize:12,color:"#6B7280",fontWeight:600,whiteSpace:"nowrap",padding:"0 4px"}}>{filtered.length} alat</div>
        </div>

        {/* ── TABLE ── */}
        <div style={{background:"#fff",borderRadius:12,overflow:"hidden",boxShadow:"0 1px 6px rgba(0,0,0,.06)"}}>
          <div style={{background:"linear-gradient(to right, #0F2D5B, #1B3A6B)",padding:"14px 20px"}}>
            <div style={{color:"#E8821C",fontSize:10,fontWeight:700,letterSpacing:1.2,textTransform:"uppercase"}}>Laboratorium</div>
            <div style={{color:"#fff",fontSize:16,fontWeight:800}}>Lab {tab}</div>
          </div>

          {tab === "Rekayasa Pengendalian Risiko" && filtered.length === 0 ? (
            <div style={{padding:"60px 20px",textAlign:"center",color:"#9CA3AF"}}>
              <div style={{fontSize:40,marginBottom:12}}>⚙️</div>
              <div style={{fontWeight:700,fontSize:16,color:"#374151",marginBottom:8}}>Data inventaris belum tersedia</div>
              <div style={{fontSize:13}}>Laboratorium Rekayasa Pengendalian Risiko sedang dalam pengembangan. Data alat akan ditambahkan segera.</div>
            </div>
          ) : filtered.length === 0 ? (
            <div style={{padding:"60px 20px",textAlign:"center",color:"#9CA3AF"}}>
              <div style={{fontSize:36,marginBottom:8}}>📭</div>
              <div style={{fontSize:13}}>Tidak ada alat yang sesuai kriteria pencarian.</div>
            </div>
          ) : (
            <div style={{overflowX:"auto"}}>
              <table style={{width:"100%",borderCollapse:"collapse",minWidth:700}}>
                <thead>
                  <tr style={{background:"#F8FAFF",borderBottom:"2px solid #E8F0FE"}}>
                    {["No","Nama Alat","Kegunaan / Catatan","Rasio","Jumlah","Th. Pengadaan","Kondisi",""].map((h,i) => (
                      <th key={i} style={{padding:"10px 14px",textAlign: [3,4,5,7].includes(i) ? "center" : "left",color:"#1B3A6B",fontWeight:700,fontSize:12,whiteSpace:"nowrap",letterSpacing:.3}}>
                        {h}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>{rows}</tbody>
              </table>
            </div>
          )}
        </div>

        <div style={{textAlign:"center",marginTop:12,color:"#9CA3AF",fontSize:11}}>
          Inventaris Lab K3 • Poltekkes Kemenkes Malang • Data tersinkron real-time
        </div>
      </div>

      {/* ── EDIT MODAL ── */}
      {editItem && (
        <div style={{position:"fixed",inset:0,background:"rgba(0,0,0,.5)",display:"flex",alignItems:"center",justifyContent:"center",zIndex:1000,padding:16}}
          onClick={e=>{ if(e.target===e.currentTarget) setEditItem(null); }}>
          <div style={{background:"#fff",borderRadius:16,width:"100%",maxWidth:460,boxShadow:"0 20px 60px rgba(0,0,0,.3)",animation:"fadeIn .2s ease",overflow:"hidden"}}>
            <div style={{background:"linear-gradient(to right, #0F2D5B, #1B3A6B)",padding:"18px 22px",display:"flex",alignItems:"center",justifyContent:"space-between"}}>
              <div>
                <div style={{color:"#E8821C",fontSize:10,fontWeight:700,letterSpacing:1.2,textTransform:"uppercase"}}>Edit Data — {editItem.id}</div>
                <div style={{color:"#fff",fontSize:15,fontWeight:800,marginTop:3}}>{editItem.nama}</div>
              </div>
              <button onClick={()=>setEditItem(null)} style={{background:"rgba(255,255,255,.15)",border:"none",borderRadius:8,width:32,height:32,color:"#fff",fontSize:18,cursor:"pointer",display:"flex",alignItems:"center",justifyContent:"center"}}>✕</button>
            </div>
            <div style={{padding:22,display:"flex",flexDirection:"column",gap:14}}>
              <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
                <div>
                  <label style={{display:"block",fontSize:11,fontWeight:700,color:"#374151",textTransform:"uppercase",letterSpacing:.6,marginBottom:5}}>Jumlah Unit</label>
                  <input value={form.jumlah} onChange={e=>setForm(f=>({...f,jumlah:e.target.value}))} placeholder="Contoh: 2"/>
                </div>
                <div>
                  <label style={{display:"block",fontSize:11,fontWeight:700,color:"#374151",textTransform:"uppercase",letterSpacing:.6,marginBottom:5}}>Tahun Pengadaan</label>
                  <input value={form.tahun} onChange={e=>setForm(f=>({...f,tahun:e.target.value}))} placeholder="Contoh: 2024"/>
                </div>
              </div>
              <div>
                <label style={{display:"block",fontSize:11,fontWeight:700,color:"#374151",textTransform:"uppercase",letterSpacing:.6,marginBottom:5}}>Kondisi Alat</label>
                <select value={form.kondisi} onChange={e=>setForm(f=>({...f,kondisi:e.target.value}))}>
                  {Object.keys(KONDISI).map(k => <option key={k} value={k}>{k}</option>)}
                </select>
              </div>
              <div>
                <label style={{display:"block",fontSize:11,fontWeight:700,color:"#374151",textTransform:"uppercase",letterSpacing:.6,marginBottom:5}}>Catatan</label>
                <textarea value={form.catatan} onChange={e=>setForm(f=>({...f,catatan:e.target.value}))} placeholder="Catatan kondisi, kalibrasi, perbaikan, expired, dll…"/>
              </div>
              <div>
                <label style={{display:"block",fontSize:11,fontWeight:700,color:"#374151",textTransform:"uppercase",letterSpacing:.6,marginBottom:5}}>Diperbarui oleh (opsional)</label>
                <input value={editor} onChange={e=>setEditor(e.target.value)} placeholder="Nama dosen atau mahasiswa / NIM"/>
                <div style={{fontSize:11,color:"#9CA3AF",marginTop:4}}>Dicatat sebagai log pembaruan terakhir untuk semua pengguna</div>
              </div>
              <div style={{display:"flex",gap:10,marginTop:4}}>
                <button className="cancel-btn" onClick={()=>setEditItem(null)}
                  style={{flex:1,border:"1.5px solid #E5E7EB",borderRadius:10,padding:"11px",background:"#fff",color:"#6B7280",fontSize:13,fontWeight:600,cursor:"pointer"}}>
                  Batal
                </button>
                <button className="save-btn" onClick={handleSave} disabled={saving}
                  style={{flex:2,border:"none",borderRadius:10,padding:"11px",background:"#E8821C",color:"#fff",fontSize:14,fontWeight:800}}>
                  {saving ? "⏳ Menyimpan…" : "💾 Simpan & Sinkron"}
                </button>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
